    { "type": "text", "id": "C", "text": "回転して登場", "x": 960, "y": 650, "size": 100, "weight": 900,
      "stack": [ { "id": "F", "type": "fill", "paint": { "type": "solid", "color": "#FFFF6FA8" } },
